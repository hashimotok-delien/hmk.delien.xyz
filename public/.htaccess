# =========================================================
#  hmk.delien.xyz
#   - 拡張子なし URL でアクセスできるようにする
#       /foo.php  -> /foo
#       /foo.html -> /foo
#       /foo/index.php -> /foo/
#   - /docs/ 配下は docs.delien.xyz へ移管（301）
# =========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- include/ はサーバーサイド専用（直接アクセスを禁止） ---
  RewriteRule (^|/)include(/|$) - [F,L]

  # --- /docs/... は docs.delien.xyz へ恒久転送 ---
  RewriteRule ^docs$ https://docs.delien.xyz/ [R=301,L,NE]
  RewriteRule ^docs/(.*)$ https://docs.delien.xyz/$1 [R=301,L,NE]

  # --- 旧 /calendar（calendar.php）は /deliencalendar/ へ恒久転送 ---
  RewriteRule ^calendar/?$ /deliencalendar/ [R=301,L,NE]

  # --- /foo/index.php, /foo/index.html -> /foo/ ---
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(?:php|html)[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # --- /foo.php, /foo.html -> /foo ---
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:php|html)[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # --- /foo -> /foo.php（内部処理） ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# =========================================================
#  静的アセットのキャッシュ期間
#   - CSS/JS は ?v=<更新日時> で参照しているため長期キャッシュ可
#   - 画像を差し替えるときは ?v= を更新するかファイル名を変える
# =========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"

  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType text/javascript        "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  ExpiresByType image/png     "access plus 1 year"
  ExpiresByType image/jpeg    "access plus 1 year"
  ExpiresByType image/gif     "access plus 1 year"
  ExpiresByType image/webp    "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon  "access plus 1 year"

  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

DirectoryIndex index.php index.html
